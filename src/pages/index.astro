---
import Asterisk from "../components/Asterisk.astro";
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import Sculpture from "../components/Sculpture.astro";
import CTA from "../components/CTA.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="Hah. — Considered design. Lasting impressions."
  description="Hah. is an independent creative studio shaping thoughtful brands and digital experiences. A little curiosity. A lot of intention."
  current="Home"
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> Independent creative studio
      </p>
      <h1>
        Good ideas.
        <br />
        Beautifully
        <br />
        <span class="hero-last">
          realised<span class="red">.</span>
        </span>
      </h1>
      <p class="hero-description">
        We shape brands and digital experiences
        <br class="desktop-break" /> with clarity, character, and a little
        unexpected.
      </p>
      <a class="button button-red" href={`${base}/contact/`}>
        Let’s create something <Arrow />
      </a>
    </div>
    <div class="hero-art">
      <span class="art-cross cross-one" aria-hidden="true">
        +
      </span>
      <Sculpture />
      <span class="art-cross cross-two" aria-hidden="true">
        +
      </span>
      <div class="art-caption">
        <span>FORM / FEELING / FUNCTION</span>
        <span>01 — ∞</span>
      </div>
    </div>
    <div class="hero-bottom">
      <span>Small studio. Thoughtful work.</span>
      <a href="#selected-work">
        A little of what we do <span aria-hidden="true">↓</span>
      </a>
      <span class="hero-location">
        Open to possibilities <span class="status-dot"></span>
      </span>
    </div>
  </section>
  <section class="intro-section shell">
    <p class="eyebrow section-label">01 / The idea</p>
    <div>
      <h2>
        Less noise.
        <br />
        More <span class="muted">meaning.</span>
      </h2>
      <p>
        Good design feels effortless. Getting there takes curiosity, care, and
        the courage to keep things simple. We bring all three to every brand,
        website, and experience we create.
      </p>
      <a class="text-link" href={`${base}/about/`}>
        A little about Hah. <Arrow />
      </a>
    </div>
    <span class="intro-asterisk" aria-hidden="true">
      <Asterisk />
    </span>
  </section>
  <section id="selected-work" class="work-section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / Studio explorations</p>
        <h2>
          A sense of
          <br />
          what’s possible<span class="red">.</span>
        </h2>
      </div>
      <p>
        A few self-initiated concepts.
        <br />
        Room to explore. Ideas to build on.
      </p>
    </div>
    <div class="work-grid">
      <a class="project-card" href={`${base}/services/#brand`}>
        <div class="project-art project-form">
          <span class="project-tag">BRAND EXPLORATION</span>
          <div class="form-poster">
            <span class="poster-small">OBJECTS WITH INTENTION</span>
            <span class="form-title">
              form<span>®</span>
            </span>
            <div class="form-object"></div>
            <span class="poster-bottom">A quieter kind of everyday.</span>
          </div>
          <span class="project-open">
            <Arrow />
          </span>
        </div>
        <div class="project-info">
          <h3>Form & feeling</h3>
          <span>Identity / Art direction</span>
        </div>
      </a>
      <a class="project-card" href={`${base}/services/#digital`}>
        <div class="project-art project-still">
          <span class="project-tag">DIGITAL EXPLORATION</span>
          <div class="still-window">
            <div class="still-nav">
              <span>still.</span>
              <span>A place to slow down ↗</span>
            </div>
            <div class="still-landscape">
              <div class="still-sun"></div>
              <div class="hill hill-back"></div>
              <div class="hill hill-front"></div>
              <h4>
                Find your
                <br />
                <i>own pace.</i>
              </h4>
              <span class="still-pill">Explore the experience ↗</span>
            </div>
          </div>
          <span class="project-open">
            <Arrow />
          </span>
        </div>
        <div class="project-info">
          <h3>A moment of still</h3>
          <span>Web design / Development</span>
        </div>
      </a>
    </div>
  </section>
  <section class="services-section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / What we bring</p>
        <h2>
          From first thought
          <br />
          to final detail.
        </h2>
      </div>
      <a class="text-link" href={`${base}/services/`}>
        Explore our services <Arrow />
      </a>
    </div>
    <div class="service-list">
      {[
        [
          "01",
          "Brand identity",
          "A clear point of view. A distinctive way to show it.",
          "brand",
        ],
        [
          "02",
          "Digital experiences",
          "Thoughtful websites that feel as good as they work.",
          "digital",
        ],
        [
          "03",
          "Creative direction",
          "One coherent vision, down to the smallest detail.",
          "direction",
        ],
      ].map(([number, title, copy, id]) => (
        <a class="service-row" href={`${base}/services/#${id}`}>
          <span class="service-number">{number}</span>
          <h3>{title}</h3>
          <p>{copy}</p>
          <Arrow />
        </a>
      ))}
    </div>
  </section>
  <CTA />
</Layout>
